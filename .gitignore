# Secrets — never in git
.env
# Backups and local variants of it too: .env.local, .env.backup, any other.
# This pattern covers them all except the example template, which holds no
# real values.
.env.*
!.env.example

# The local database
data/*.db
data/*.db-wal
data/*.db-shm

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.DS_Store
