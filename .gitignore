# סודות — לעולם לא ב-git
.env
# גם גיבויים וגרסאות מקומיות שלו: .env.local, .env.backup וכל וריאנט אחר.
# הדפוס הזה מכסה הכל חוץ מהתבנית לדוגמה, שאין בה ערכים אמיתיים.
.env.*
!.env.example

# מסד הנתונים המקומי
data/*.db
data/*.db-wal
data/*.db-shm

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.DS_Store
