# Copy to a file named .env and fill in real values.
# .env is in .gitignore and never enters git.

# --------------------------------------------------------------- Security
# To generate the hash:  python -m app.hashpw
APP_PASSWORD_HASH=
# A long random string. To generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Turn on (1) when the site runs behind HTTPS — that is, in the cloud.
COOKIE_SECURE=0

# ------------------------------------------- The dedicated Gmail account
# Leave empty to work with manual pasting only.
IMAP_USER=
# A Gmail App Password (16 characters), not the account's regular password.
# Requires 2-Step Verification to be enabled on the account.
IMAP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX
POLL_MINUTES=5

# --------------------------------------------------------------- Database
# Empty = SQLite in a local file (the default, suitable for running locally).
# Set    = PostgreSQL. The container is then stateless and can be hosted in the
#          cloud without a persistent disk.
# To move existing data:  py -m app.migrate_to_postgres
DATABASE_URL=

# ---------------------------------------------------------------- General
# Relevant only when there is no DATABASE_URL.
# If SQLite is used in the cloud anyway — a path on a persistent disk, or the
# data will be wiped.
DB_PATH=data/warehouse.db
PORT=8000
TZ_NAME=Asia/Jerusalem
