# העתיקי לקובץ בשם .env ומלאי ערכים אמיתיים.
# .env נמצא ב-.gitignore ולעולם לא נכנס ל-git.

# ---------------------------------------------------------------- אבטחה
# ליצירת ה-hash:  python -m app.hashpw
APP_PASSWORD_HASH=
# מחרוזת אקראית ארוכה. ליצירה:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# להדליק (1) כשהאתר רץ מאחורי HTTPS — כלומר בענן.
COOKIE_SECURE=0

# ------------------------------------------------- חשבון ה-Gmail הייעודי
# משאירים ריק כדי לעבוד בהדבקה ידנית בלבד.
IMAP_USER=
# App Password של Gmail (16 תווים), לא סיסמת החשבון הרגילה.
# דורש שאימות דו-שלבי יהיה פעיל בחשבון.
IMAP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX
POLL_MINUTES=5

# -------------------------------------------------------------- מסד הנתונים
# ריק  = SQLite בקובץ מקומי (ברירת המחדל, מתאים להרצה מקומית).
# מוגדר = PostgreSQL. כך הקונטיינר חסר-מצב ואפשר לארח בענן בלי דיסק קבוע.
# להעברת נתונים קיימים:  py -m app.migrate_to_postgres
DATABASE_URL=

# ---------------------------------------------------------------- כללי
# רלוונטי רק כשאין DATABASE_URL.
# אם בכל זאת מריצים SQLite בענן — נתיב על דיסק קבוע, אחרת הנתונים יימחקו.
DB_PATH=data/warehouse.db
PORT=8000
TZ_NAME=Asia/Jerusalem
